[Unit]
Description=ERM Daily Monthly Risk Report Reminder
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=adminsvr
Group=adminsvr
WorkingDirectory=/home/adminsvr/erm
EnvironmentFile=-/home/adminsvr/erm/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/adminsvr/erm/venv/bin/python /home/adminsvr/erm/manage.py send_monthly_report_daily_reminders --base-url https://erm.plnbatam.com
